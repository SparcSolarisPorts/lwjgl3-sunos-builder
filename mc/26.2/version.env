# Minecraft 26.2
MC_VERSION=26.2
LWJGL_VERSION=3.4.1
LWJGL_URL=${LWJGL_URL:-https://github.com/LWJGL/lwjgl3.git}
LWJGL_REF=${LWJGL_REF:-3.4.1}
# GLFW, jemalloc and OpenAL Soft keep a stable C ABI, so one pinned ref serves
# every version. Override here if a release ever needs an exact match.
GLFW_URL=${GLFW_URL:-https://github.com/glfw/glfw.git}
GLFW_REF=${GLFW_REF:-3.5.1}
JEMALLOC_URL=${JEMALLOC_URL:-https://github.com/jemalloc/jemalloc.git}
JEMALLOC_REF=${JEMALLOC_REF:-5.3.0}
OPENAL_URL=${OPENAL_URL:-https://github.com/kcat/openal-soft.git}
OPENAL_REF=${OPENAL_REF:-1.23.1}
# Static libffi for liblwjgl.so; the SunOS ant config requires LWJGL_SUNOS_LIBFFI_A.
LIBFFI_URL=${LIBFFI_URL:-https://github.com/libffi/libffi.git}
LIBFFI_REF=${LIBFFI_REF:-v3.8.0}
# FreeType (the version LWJGL 3.4.1 ships).
FREETYPE_URL=${FREETYPE_URL:-https://github.com/freetype/freetype.git}
FREETYPE_REF=${FREETYPE_REF:-VER-2-14-1}
# LWJGL's CI forks fold glslang/SPIRV-Tools into libshaderc and export the
# SPIRV-Cross C API; the stock upstream repositories are not enough.
SHADERC_URL=${SHADERC_URL:-https://github.com/LWJGL-CI/shaderc.git}
SHADERC_REF=${SHADERC_REF:-LWJGL-3.4.3}
SPVC_URL=${SPVC_URL:-https://github.com/LWJGL-CI/SPIRV-Cross.git}
SPVC_REF=${SPVC_REF:-LWJGL-3.4.3}
COMPONENTS="libffi glfw lwjgl3 jemalloc openal freetype shaderc spvc"
NATIVES="liblwjgl.so libjemalloc.so libopenal.so liblwjgl_opengl.so liblwjgl_stb.so libglfw.so liblwjgl_tinyfd.so libfreetype.so liblwjgl_vma.so libshaderc.so libspirv-cross.so"
