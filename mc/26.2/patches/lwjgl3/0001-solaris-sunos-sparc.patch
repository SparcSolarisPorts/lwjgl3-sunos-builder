diff --git a/config/sunos/build.xml b/config/sunos/build.xml
new file mode 100644
index 000000000..34c53af8f
--- /dev/null
+++ b/config/sunos/build.xml
@@ -0,0 +1,192 @@
+<!--
+  ~ Copyright LWJGL. All rights reserved.
+  ~ License terms: https://www.lwjgl.org/license
+  -->
+<project name="native-sunos" basedir="../.." xmlns:if="ant:if" xmlns:unless="ant:unless">
+    <import file="../build-definitions.xml"/>
+
+    <!-- Native compilers: CC / CXX from the environment (e.g. gcc -m64), defaults to GCC from PATH. -->
+    <condition property="sunos.cc"  value="${env.CC}"  else="gcc"><isset property="env.CC"/></condition>
+    <condition property="sunos.cxx" value="${env.CXX}" else="g++"><isset property="env.CXX"/></condition>
+
+    <property name="module.lwjgl.rel" value="../../../../${module.lwjgl}"/>
+
+    <macrodef name="compile">
+        <attribute name="dest" default="${dest}"/>
+        <attribute name="lang" default="c"/>
+        <attribute name="flags" default=""/>
+        <attribute name="simple" default="false"/>
+        <attribute name="relative" default="true"/>
+        <element name="source" implicit="true" optional="true"/>
+        <sequential>
+            <local name="cpp"/>
+            <condition property="cpp"><not><equals arg1="@{lang}" arg2="c"/></not></condition>
+            <local name="cc"/>
+            <condition property="cc" value="${sunos.cc}" else="${sunos.cxx}"><equals arg1="@{lang}" arg2="c"/></condition>
+            <mkdir dir="@{dest}"/>
+            <apply dir="@{dest}" executable="${cc}" dest="@{dest}" skipemptyfilesets="true" failonerror="true" parallel="true" taskname="Compiler">
+                <arg line="-c -std=gnu11" unless:set="cpp"/>
+                <arg line="-c -std=gnu++17" if:set="cpp"/>
+                <arg line="-m64" if:set="build.arch.x64"/>
+                <arg line="-m64" if:set="build.arch.sparc64"/>
+                <arg line="-O2 -fPIC @{flags} -pthread -DNDEBUG -DLWJGL_SUNOS -DLWJGL_${build.arch}"/>
+                <arg line="-D__EXTENSIONS__ -D_REENTRANT -D_FILE_OFFSET_BITS=64"/>
+
+                <arg value="-I${jni.headers}"/>
+                <arg value="-I${jni.headers}/solaris"/>
+
+                <arg value="-I${module.lwjgl.rel}/core/src/main/c"/>
+                <arg value="-I${module.lwjgl.rel}/core/src/main/c/${platform}"/>
+
+                <arg value="-I${src.main.rel}" if:true="@{simple}"/>
+
+                <source/>
+                <fileset dir="." includes="${src.generated}/*" if:true="@{simple}"/>
+
+                <regexpmapper from="([\w\-]+)\.(?:c|cc|cpp|S)$" to="\1.o"/>
+            </apply>
+        </sequential>
+    </macrodef>
+
+    <macrodef name="build">
+        <attribute name="module"/>
+        <attribute name="suffix" default=""/>
+        <attribute name="linker" default="gcc"/>
+        <attribute name="lang" default="c"/>
+        <attribute name="flags" default=""/>
+        <attribute name="simple" default="false"/>
+        <element name="beforeCompile" optional="true"/>
+        <element name="source" optional="true"/>
+        <element name="beforeLink" optional="true"/>
+        <element name="link" optional="true"/>
+        <sequential>
+            <local name="src.main"/>
+            <local name="src.main.rel"/>
+            <local name="src.generated"/>
+            <property name="src.main" location="${module.lwjgl}/@{module}/src/main/c" relative="true"/>
+            <property name="src.main.rel" value="${module.lwjgl.rel}/@{module}/src/main/c"/>
+            <property name="src.generated" location="${module.lwjgl}/@{module}/src/generated/c" relative="true"/>
+
+            <local name="name"/>
+            <condition property="name" value="lwjgl" else="lwjgl_@{module}@{suffix}">
+                <equals arg1="@{module}" arg2="core"/>
+            </condition>
+
+            <local name="dest"/>
+            <property name="dest" value="${bin.native}/@{module}@{suffix}"/>
+
+            <beforeCompile/>
+            <compile lang="@{lang}" flags="@{flags}" simple="@{simple}">
+                <source/>
+            </compile>
+
+            <local name="lib.arch"/>
+            <property name="lib.arch" value="${lib.native}/${module.@{module}.path}"/>
+
+            <local name="cc"/>
+            <condition property="cc" value="${sunos.cc}" else="${sunos.cxx}">
+                <and>
+                    <equals arg1="@{lang}" arg2="c"/>
+                    <equals arg1="@{linker}" arg2="gcc"/>
+                </and>
+            </condition>
+
+            <local name="static.runtime"/>
+            <condition property="static.runtime" value="true"><not><equals arg1="@{lang}" arg2="c"/></not></condition>
+
+            <echo message="Linking ${name}" taskname="${cc}"/>
+            <mkdir dir="${lib.arch}"/>
+            <beforeLink/>
+            <apply executable="${cc}" failonerror="true" parallel="true" taskname="Linker">
+                <srcfile/>
+                <arg value="-shared"/>
+                <arg value="-m64" if:set="build.arch.x64"/>
+                <arg value="-m64" if:set="build.arch.sparc64"/>
+
+                <arg line="-O2 -fPIC -pthread -o ${lib.arch}/lib${name}.so"/>
+                <arg line="-static-libgcc -static-libstdc++" if:set="static.runtime"/>
+
+                <fileset dir="${dest}" includes="*.o"/>
+                <link/>
+            </apply>
+
+            <delete file="${lib.native}/touch.txt" quiet="true"/>
+        </sequential>
+    </macrodef>
+
+    <macrodef name="build_simple">
+        <attribute name="module"/>
+        <sequential>
+            <build module="@{module}" simple="true" if:true="${binding.@{module}}"/>
+        </sequential>
+    </macrodef>
+
+    <target name="compile-native-platform">
+        <fail message="SunOS requires LWJGL_SUNOS_LIBFFI_A to point to a libffi static archive (-fPIC, 64-bit) for the selected architecture." unless="env.LWJGL_SUNOS_LIBFFI_A"/>
+
+        <parallel threadsPerProcessor="2">
+
+        <!-- CORE -->
+        <build module="core" flags="-Wall -Wextra">
+            <source>
+                <arg value="-I${src.main.rel}/libffi"/>
+                <arg value="-I${src.main.rel}/libffi/aarch64" if:set="build.arch.arm64"/>
+                <arg value="-I${src.main.rel}/libffi/sparc" if:set="build.arch.sparc64"/>
+                <arg value="-I${src.main.rel}/libffi/x86" if:set="build.arch.x64"/>
+                <arg value="-DX86_64" if:set="build.arch.x64"/> <!-- for libffi/x86/ffitarget.h -->
+                <fileset dir=".">
+                    <include name="${src.main}/*.c"/>
+                    <include name="${src.generated}/*.c"/>
+                    <include name="${src.generated}/${platform}/*.c"/>
+                </fileset>
+            </source>
+            <link>
+                <arg value="${env.LWJGL_SUNOS_LIBFFI_A}"/>
+                <arg value="-ldl"/>
+            </link>
+        </build>
+
+        <!-- OpenGL -->
+        <build module="opengl">
+            <source>
+                <arg value="-I${src.main.rel}"/>
+                <fileset dir="." includes="${src.generated}/*" excludes="${src.generated}/org_lwjgl_opengl_WGL.c"/>
+            </source>
+        </build>
+
+        <!-- OpenGL ES -->
+        <build_simple module="opengles"/>
+
+        <!-- stb -->
+        <build module="stb" if:true="${binding.stb}">
+            <source>
+                <arg value="-isystem${src.main.rel}"/>
+                <fileset dir="." includes="${src.generated}/*.c"/>
+            </source>
+            <link>
+                <arg value="-lm"/>
+            </link>
+        </build>
+
+        <!-- tiny file dialogs -->
+        <build module="tinyfd" simple="true" if:true="${binding.tinyfd}">
+            <beforeCompile>
+                <compile>
+                    <arg value="-I${src.main.rel}"/>
+                    <fileset dir="." includes="${src.main}/*.c"/>
+                </compile>
+            </beforeCompile>
+        </build>
+
+        <!-- Vulkan Memory Allocator -->
+        <build module="vma" lang="c++" if:true="${binding.vma}">
+            <source>
+                <arg value="-I${src.main.rel}"/>
+                <arg value="-I${module.lwjgl.rel}/vulkan/src/main/c"/>
+                <fileset dir="." includes="${src.generated}/*.cpp"/>
+            </source>
+        </build>
+
+        </parallel>
+    </target>
+</project>
