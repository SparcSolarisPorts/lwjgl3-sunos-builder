diff --git a/config/sunos/build.xml b/config/sunos/build.xml
new file mode 100644
index 000000000..70c0860ac
--- /dev/null
+++ b/config/sunos/build.xml
@@ -0,0 +1,148 @@
+<!--
+  ~ Copyright LWJGL. All rights reserved.
+  ~ License terms: https://www.lwjgl.org/license
+  -->
+<project name="native-sunos" basedir="../.." xmlns:if="ant:if" xmlns:unless="ant:unless">
+    <import file="../build-definitions.xml"/>
+
+    <!-- Native compiler: CC from the environment, defaults to GCC from PATH. Only 64-bit (SPARC V9) is supported. -->
+    <condition property="sunos.cc" value="${env.CC}" else="gcc"><isset property="env.CC"/></condition>
+
+    <property name="module.lwjgl.rel" value="../../../../${module.lwjgl}"/>
+
+    <macrodef name="compile">
+        <attribute name="dest" default="${dest}"/>
+        <attribute name="flags" default=""/>
+        <attribute name="simple" default="false"/>
+        <element name="source" implicit="true" optional="true"/>
+        <sequential>
+            <mkdir dir="@{dest}"/>
+            <apply dir="@{dest}" executable="${sunos.cc}" dest="@{dest}" skipemptyfilesets="true" failonerror="true" parallel="true" taskname="Compiler">
+                <arg line="-c -std=gnu11"/>
+                <arg line="-m64"/>
+                <arg line="-O2 -fPIC @{flags} -pthread -DNDEBUG -DLWJGL_SUNOS -DLWJGL_${build.arch}"/>
+                <arg line="-D__EXTENSIONS__ -D_REENTRANT"/>
+
+                <arg value="-I${jni.headers}"/>
+                <arg value="-I${jni.headers}/solaris"/>
+
+                <arg value="-I${module.lwjgl.rel}/core/src/main/c"/>
+                <arg value="-I${module.lwjgl.rel}/core/src/main/c/${platform}"/>
+
+                <arg value="-I${src.main.rel}" if:true="@{simple}"/>
+
+                <source/>
+                <fileset dir="." includes="${src.generated}/*.c" if:true="@{simple}"/>
+
+                <regexpmapper from="(\w+)\.c$" to="\1.o"/>
+            </apply>
+        </sequential>
+    </macrodef>
+
+    <macrodef name="build">
+        <attribute name="module"/>
+        <attribute name="flags" default=""/>
+        <attribute name="simple" default="false"/>
+        <element name="beforeCompile" optional="true"/>
+        <element name="source" optional="true"/>
+        <element name="link" optional="true"/>
+        <sequential>
+            <local name="src.main"/>
+            <local name="src.main.rel"/>
+            <local name="src.generated"/>
+            <property name="src.main" location="${module.lwjgl}/@{module}/src/main/c" relative="true"/>
+            <property name="src.main.rel" value="${module.lwjgl.rel}/@{module}/src/main/c"/>
+            <property name="src.generated" location="${module.lwjgl}/@{module}/src/generated/c" relative="true"/>
+
+            <local name="name"/>
+            <condition property="name" value="lwjgl" else="lwjgl_@{module}">
+                <equals arg1="@{module}" arg2="core"/>
+            </condition>
+
+            <local name="dest"/>
+            <property name="dest" value="${bin.native}/@{module}"/>
+
+            <beforeCompile/>
+            <compile flags="@{flags}" simple="@{simple}">
+                <source/>
+            </compile>
+
+            <echo message="Linking ${name}" taskname="${sunos.cc}"/>
+            <mkdir dir="${lib}"/>
+            <apply executable="${sunos.cc}" failonerror="true" parallel="true" taskname="Linker">
+                <srcfile/>
+                <arg value="-shared"/>
+                <arg value="-m64"/>
+
+                <arg line="-O2 -fPIC -pthread -o ${lib}/lib${name}.so"/>
+
+                <fileset dir="${dest}" includes="*.o"/>
+                <link/>
+            </apply>
+        </sequential>
+    </macrodef>
+
+    <macrodef name="build_simple">
+        <attribute name="module"/>
+        <sequential>
+            <build module="@{module}" simple="true" if:true="${binding.@{module}}"/>
+        </sequential>
+    </macrodef>
+
+    <target name="compile-native-platform">
+        <fail message="SunOS requires LWJGL_SUNOS_LIBFFI_A to point to a libffi static archive (-fPIC, 64-bit) for the selected architecture." unless="env.LWJGL_SUNOS_LIBFFI_A"/>
+
+        <!-- The libffi build tree/prefix keeps ffi.h in an include directory next to the directory that contains libffi.a. -->
+        <dirname property="libffi.dir" file="${env.LWJGL_SUNOS_LIBFFI_A}"/>
+
+        <parallel threadsPerProcessor="2">
+
+        <!-- CORE -->
+        <build module="core" flags="-Wall -Wextra">
+            <source>
+                <arg value="-I${src.main.rel}/dyncall"/>
+                <arg value="-I${libffi.dir}/../include"/>
+                <arg value="-I${env.LWJGL_SUNOS_LIBFFI_INCLUDE}" if:set="env.LWJGL_SUNOS_LIBFFI_INCLUDE"/>
+                <fileset dir=".">
+                    <include name="${src.main}/*.c"/>
+                    <include name="${src.main}/${platform}/dyncall_ffi.c"/>
+                    <include name="${src.generated}/*.c"/>
+                    <include name="${src.generated}/linux/*.c"/> <!-- dlfcn: SunOS uses the org.lwjgl.system.linux bindings -->
+                </fileset>
+            </source>
+            <link>
+                <arg value="${env.LWJGL_SUNOS_LIBFFI_A}"/>
+                <arg value="-ldl"/>
+            </link>
+        </build>
+
+        <!-- OpenGL -->
+        <build_simple module="opengl"/>
+
+        <!-- OpenGL ES -->
+        <build_simple module="opengles"/>
+
+        <!-- stb -->
+        <build module="stb" if:true="${binding.stb}">
+            <source>
+                <arg value="-isystem${src.main.rel}"/>
+                <fileset dir="." includes="${src.generated}/*.c"/>
+            </source>
+            <link>
+                <arg value="-lm"/>
+            </link>
+        </build>
+
+        <!-- tiny file dialogs -->
+        <build module="tinyfd" simple="true" if:true="${binding.tinyfd}">
+            <beforeCompile>
+                <compile>
+                    <arg value="-I${src.main.rel}"/>
+                    <fileset dir="." includes="${src.main}/*.c"/>
+                </compile>
+            </beforeCompile>
+        </build>
+
+        </parallel>
+    </target>
+</project>
