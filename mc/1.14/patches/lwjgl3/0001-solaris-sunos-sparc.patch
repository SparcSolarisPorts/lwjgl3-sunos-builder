diff --git a/modules/lwjgl/core/src/main/c/sunos/dyncall_ffi.c b/modules/lwjgl/core/src/main/c/sunos/dyncall_ffi.c
new file mode 100644
index 000000000..a10d4525c
--- /dev/null
+++ b/modules/lwjgl/core/src/main/c/sunos/dyncall_ffi.c
@@ -0,0 +1,627 @@
+/*
+ * Copyright LWJGL. All rights reserved.
+ * License terms: https://www.lwjgl.org/license
+ */
+
+/*
+ * libffi based implementation of the subset of the dyncall API that LWJGL 3.2.x uses (dyncall, dyncallback and dynload).
+ *
+ * The prebuilt dyncall static libraries that LWJGL downloads for its other platforms do not exist for SunOS (SPARC V9), so this file provides the same entry
+ * points on top of a static libffi, which is linked into liblwjgl.so.
+ *
+ * Differences from dyncall:
+ * - struct support (dcNewStruct, dcDefineStruct, dcArgStruct, dcCallStruct, ...) is not implemented; the functions are safe no-ops.
+ * - dcbInitCallback (callback in caller provided memory) is not implemented.
+ * - dlSyms* (library symbol enumeration) is not implemented.
+ * - callback signatures must list the argument types (as LWJGL's do), because libffi needs them when the callback is created.
+ */
+#include <dlfcn.h>
+#ifdef __sun
+    #include <link.h>
+#endif
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <ffi.h>
+
+#include "dyncall.h"
+#include "dyncall_callback.h"
+#include "dynload.h"
+
+#define DCFFI_ERROR_NONE             0
+#define DCFFI_ERROR_UNSUPPORTED_MODE (-1)
+
+/* ------------------------------------------------------------------------------------------------------------------ */
+/* dyncall: call VM                                                                                                   */
+/* ------------------------------------------------------------------------------------------------------------------ */
+
+typedef union DCFFIValue {
+    signed char c;
+    short       s;
+    int         i;
+    long        j;
+    long long   l;
+    float       f;
+    double      d;
+    void*       p;
+} DCFFIValue;
+
+struct DCCallVM_ {
+    DCFFIValue* store;
+    ffi_type**  types;
+    void**      values;
+    size_t      count;
+    size_t      capacity;
+    int         error;
+};
+
+DCCallVM* dcNewCallVM(DCsize size) {
+    DCCallVM* vm = (DCCallVM*)calloc(1, sizeof(DCCallVM));
+    (void)size;
+    return vm;
+}
+
+void dcFree(DCCallVM* vm) {
+    if (vm == NULL) {
+        return;
+    }
+    free(vm->store);
+    free(vm->types);
+    free(vm->values);
+    free(vm);
+}
+
+void dcReset(DCCallVM* vm) {
+    vm->count = 0;
+    vm->error = DCFFI_ERROR_NONE;
+}
+
+void dcMode(DCCallVM* vm, DCint mode) {
+    switch (mode) {
+        case DC_CALL_C_DEFAULT:
+        case DC_CALL_C_ELLIPSIS:
+        case DC_CALL_C_ELLIPSIS_VARARGS:
+        case DC_CALL_C_SPARC64:
+            vm->error = DCFFI_ERROR_NONE;
+            break;
+        default:
+            vm->error = DCFFI_ERROR_UNSUPPORTED_MODE;
+    }
+}
+
+DCint dcGetError(DCCallVM* vm) {
+    return vm->error;
+}
+
+static DCFFIValue* pushArg(DCCallVM* vm, ffi_type* type) {
+    if (vm->count == vm->capacity) {
+        size_t      capacity = vm->capacity == 0 ? 16 : vm->capacity * 2;
+        DCFFIValue* store    = (DCFFIValue*)realloc(vm->store, capacity * sizeof(DCFFIValue));
+        ffi_type**  types;
+        void**      values;
+
+        if (store == NULL) {
+            return NULL;
+        }
+        vm->store = store;
+
+        types = (ffi_type**)realloc(vm->types, capacity * sizeof(ffi_type*));
+        if (types == NULL) {
+            return NULL;
+        }
+        vm->types = types;
+
+        values = (void**)realloc(vm->values, capacity * sizeof(void*));
+        if (values == NULL) {
+            return NULL;
+        }
+        vm->values   = values;
+        vm->capacity = capacity;
+    }
+
+    vm->types[vm->count] = type;
+    return &vm->store[vm->count++];
+}
+
+#define DEFINE_ARG(Name, Type, Field, FFIType) \
+    void dcArg##Name(DCCallVM* vm, Type value) { \
+        DCFFIValue* v = pushArg(vm, &FFIType); \
+        if (v != NULL) { \
+            memset(v, 0, sizeof(DCFFIValue)); \
+            v->Field = value; \
+        } \
+    }
+
+DEFINE_ARG(Bool,     DCbool,     i, ffi_type_sint)
+DEFINE_ARG(Char,     DCchar,     c, ffi_type_schar)
+DEFINE_ARG(Short,    DCshort,    s, ffi_type_sshort)
+DEFINE_ARG(Int,      DCint,      i, ffi_type_sint)
+DEFINE_ARG(Long,     DClong,     j, ffi_type_slong)
+DEFINE_ARG(LongLong, DClonglong, l, ffi_type_sint64)
+DEFINE_ARG(Float,    DCfloat,    f, ffi_type_float)
+DEFINE_ARG(Double,   DCdouble,   d, ffi_type_double)
+DEFINE_ARG(Pointer,  DCpointer,  p, ffi_type_pointer)
+
+void dcArgStruct(DCCallVM* vm, DCstruct* s, DCpointer value) {
+    (void)s;
+    (void)value;
+    vm->error = DCFFI_ERROR_UNSUPPORTED_MODE;
+}
+
+static void doCall(DCCallVM* vm, DCpointer funcptr, ffi_type* rtype, void* rvalue) {
+    ffi_cif cif;
+    size_t  i;
+
+    for (i = 0; i < vm->count; i++) {
+        vm->values[i] = &vm->store[i];
+    }
+
+    if (ffi_prep_cif(&cif, FFI_DEFAULT_ABI, (unsigned int)vm->count, rtype, vm->types) != FFI_OK) {
+        vm->error = DCFFI_ERROR_UNSUPPORTED_MODE;
+        return;
+    }
+
+    ffi_call(&cif, FFI_FN(funcptr), rvalue, vm->values);
+}
+
+void dcCallVoid(DCCallVM* vm, DCpointer funcptr) {
+    ffi_arg r;
+    doCall(vm, funcptr, &ffi_type_void, &r);
+}
+
+#define DEFINE_CALL_INT(Name, Type, FFIType) \
+    Type dcCall##Name(DCCallVM* vm, DCpointer funcptr) { \
+        ffi_arg r = 0; \
+        doCall(vm, funcptr, &FFIType, &r); \
+        return (Type)r; \
+    }
+
+DEFINE_CALL_INT(Bool,     DCbool,     ffi_type_sint)
+DEFINE_CALL_INT(Char,     DCchar,     ffi_type_schar)
+DEFINE_CALL_INT(Short,    DCshort,    ffi_type_sshort)
+DEFINE_CALL_INT(Int,      DCint,      ffi_type_sint)
+DEFINE_CALL_INT(Long,     DClong,     ffi_type_slong)
+
+DClonglong dcCallLongLong(DCCallVM* vm, DCpointer funcptr) {
+    int64_t r = 0;
+    doCall(vm, funcptr, &ffi_type_sint64, &r);
+    return (DClonglong)r;
+}
+
+DCfloat dcCallFloat(DCCallVM* vm, DCpointer funcptr) {
+    float r = 0;
+    doCall(vm, funcptr, &ffi_type_float, &r);
+    return r;
+}
+
+DCdouble dcCallDouble(DCCallVM* vm, DCpointer funcptr) {
+    double r = 0;
+    doCall(vm, funcptr, &ffi_type_double, &r);
+    return r;
+}
+
+DCpointer dcCallPointer(DCCallVM* vm, DCpointer funcptr) {
+    void* r = NULL;
+    doCall(vm, funcptr, &ffi_type_pointer, &r);
+    return r;
+}
+
+void dcCallStruct(DCCallVM* vm, DCpointer funcptr, DCstruct* s, DCpointer returnValue) {
+    (void)funcptr;
+    (void)s;
+    (void)returnValue;
+    vm->error = DCFFI_ERROR_UNSUPPORTED_MODE;
+}
+
+/* ------------------------------------------------------------------------------------------------------------------ */
+/* dyncall: struct types (not supported)                                                                              */
+/* ------------------------------------------------------------------------------------------------------------------ */
+
+DCstruct* dcNewStruct(DCsize fieldCount, DCint alignment) {
+    (void)fieldCount;
+    (void)alignment;
+    return NULL;
+}
+
+void dcStructField(DCstruct* s, DCint type, DCint alignment, DCsize arrayLength) {
+    (void)s;
+    (void)type;
+    (void)alignment;
+    (void)arrayLength;
+}
+
+void dcSubStruct(DCstruct* s, DCsize fieldCount, DCint alignment, DCsize arrayLength) {
+    (void)s;
+    (void)fieldCount;
+    (void)alignment;
+    (void)arrayLength;
+}
+
+void dcCloseStruct(DCstruct* s) {
+    (void)s;
+}
+
+DCsize dcStructSize(DCstruct* s) {
+    (void)s;
+    return 0;
+}
+
+DCsize dcStructAlignment(DCstruct* s) {
+    (void)s;
+    return 0;
+}
+
+void dcFreeStruct(DCstruct* s) {
+    (void)s;
+}
+
+DCstruct* dcDefineStruct(const char* signature) {
+    (void)signature;
+    return NULL;
+}
+
+/* ------------------------------------------------------------------------------------------------------------------ */
+/* dyncallback                                                                                                        */
+/* ------------------------------------------------------------------------------------------------------------------ */
+
+struct DCArgs {
+    ffi_cif*     cif;
+    void**       values;
+    unsigned int index;
+};
+
+typedef struct DCFFICallback {
+    struct DCFFICallback* next;
+    ffi_closure*          closure;
+    void*                 code;
+    ffi_cif               cif;
+    ffi_type**            argTypes;
+    DCCallbackHandler*    handler;
+    void*                 userdata;
+} DCFFICallback;
+
+#define CALLBACK_BUCKETS 64
+
+static DCFFICallback*  callbacks[CALLBACK_BUCKETS];
+static pthread_mutex_t callbacksLock = PTHREAD_MUTEX_INITIALIZER;
+
+#define CALLBACK_BUCKET(code) (((uintptr_t)(code) >> 4) % CALLBACK_BUCKETS)
+
+static ffi_type* sigToType(char c) {
+    switch (c) {
+        case 'v': return &ffi_type_void;
+        case 'B': return &ffi_type_sint; /* DCbool is an int */
+        case 'c': return &ffi_type_schar;
+        case 'C': return &ffi_type_uchar;
+        case 's': return &ffi_type_sshort;
+        case 'S': return &ffi_type_ushort;
+        case 'i': return &ffi_type_sint;
+        case 'I': return &ffi_type_uint;
+        case 'j': return &ffi_type_slong;
+        case 'J': return &ffi_type_ulong;
+        case 'l': return &ffi_type_sint64;
+        case 'L': return &ffi_type_uint64;
+        case 'f': return &ffi_type_float;
+        case 'd': return &ffi_type_double;
+        case 'p':
+        case 'Z': return &ffi_type_pointer;
+        default:  return NULL;
+    }
+}
+
+static void closureDispatch(ffi_cif* cif, void* ret, void** args, void* userdata) {
+    DCFFICallback* cb = (DCFFICallback*)userdata;
+    struct DCArgs  a;
+    DCValue        r;
+    char           type;
+
+    a.cif    = cif;
+    a.values = args;
+    a.index  = 0;
+    memset(&r, 0, sizeof(r));
+
+    type = cb->handler((DCCallback*)cb->code, &a, &r, cb->userdata);
+
+    /* integers narrower than ffi_arg must be returned widened to ffi_arg */
+    switch (type) {
+        case 'B': *(ffi_arg*)ret  = r.C != 0 ? 1 : 0; break; /* LWJGL stores a jboolean (1 byte) at the start of the value */
+        case 'c': *(ffi_sarg*)ret = r.c; break;
+        case 'C': *(ffi_arg*)ret  = r.C; break;
+        case 's': *(ffi_sarg*)ret = r.s; break;
+        case 'S': *(ffi_arg*)ret  = r.S; break;
+        case 'i': *(ffi_sarg*)ret = r.i; break;
+        case 'I': *(ffi_arg*)ret  = r.I; break;
+        case 'j': *(ffi_sarg*)ret = r.j; break;
+        case 'J': *(ffi_arg*)ret  = r.J; break;
+        case 'l': *(int64_t*)ret  = (int64_t)r.l; break;
+        case 'L': *(uint64_t*)ret = (uint64_t)r.L; break;
+        case 'f': *(float*)ret    = r.f; break;
+        case 'd': *(double*)ret   = r.d; break;
+        case 'p':
+        case 'Z': *(void**)ret    = r.p; break;
+        default: break;
+    }
+}
+
+static void freeCallback(DCFFICallback* cb) {
+    if (cb->closure != NULL) {
+        ffi_closure_free(cb->closure);
+    }
+    free(cb->argTypes);
+    free(cb);
+}
+
+DCCallback* dcbNewCallback(const char* signature, DCCallbackHandler* funcptr, void* userdata) {
+    const char*    p = signature;
+    const char*    end;
+    size_t         nargs = 0;
+    size_t         i;
+    ffi_type*      rtype;
+    DCFFICallback* cb;
+    void*          code = NULL;
+
+    if (p == NULL) {
+        return NULL;
+    }
+
+    if (*p == '_') { /* calling convention prefix, ignored */
+        p += 2;
+    }
+    if (*p == '(') { /* LWJGL signatures are enclosed in parentheses, dyncall ignores the opening one */
+        p++;
+    }
+
+    /* count the arguments */
+    for (end = p; *end != ')' && *end != '\0'; end++) {
+        if (*end == '_') { /* calling convention switch, ignored */
+            end++;
+            if (*end == '\0') {
+                return NULL;
+            }
+        } else if (*end != '.') { /* start of varargs, ignored */
+            if (sigToType(*end) == NULL || *end == 'v') {
+                return NULL;
+            }
+            nargs++;
+        }
+    }
+    if (*end != ')') {
+        return NULL;
+    }
+
+    rtype = sigToType(end[1]);
+    if (rtype == NULL) {
+        return NULL;
+    }
+
+    cb = (DCFFICallback*)calloc(1, sizeof(DCFFICallback));
+    if (cb == NULL) {
+        return NULL;
+    }
+    cb->argTypes = (ffi_type**)calloc(nargs == 0 ? 1 : nargs, sizeof(ffi_type*));
+    if (cb->argTypes == NULL) {
+        free(cb);
+        return NULL;
+    }
+
+    for (i = 0; p < end; p++) {
+        if (*p == '_') {
+            p++;
+        } else if (*p != '.') {
+            cb->argTypes[i++] = sigToType(*p);
+        }
+    }
+
+    cb->handler  = funcptr;
+    cb->userdata = userdata;
+
+    cb->closure = (ffi_closure*)ffi_closure_alloc(sizeof(ffi_closure), &code);
+    if (cb->closure == NULL) {
+        freeCallback(cb);
+        return NULL;
+    }
+    cb->code = code;
+
+    if (ffi_prep_cif(&cb->cif, FFI_DEFAULT_ABI, (unsigned int)nargs, rtype, cb->argTypes) != FFI_OK ||
+        ffi_prep_closure_loc(cb->closure, &cb->cif, closureDispatch, cb, code) != FFI_OK) {
+        freeCallback(cb);
+        return NULL;
+    }
+
+    pthread_mutex_lock(&callbacksLock);
+    cb->next                         = callbacks[CALLBACK_BUCKET(code)];
+    callbacks[CALLBACK_BUCKET(code)] = cb;
+    pthread_mutex_unlock(&callbacksLock);
+
+    return (DCCallback*)code;
+}
+
+void dcbInitCallback(DCCallback* pcb, const char* signature, DCCallbackHandler* handler, void* userdata) {
+    /* not supported: libffi closures cannot be created in caller-provided memory */
+    (void)pcb;
+    (void)signature;
+    (void)handler;
+    (void)userdata;
+}
+
+void dcbFreeCallback(DCCallback* pcb) {
+    DCFFICallback** link;
+    DCFFICallback*  cb = NULL;
+
+    pthread_mutex_lock(&callbacksLock);
+    for (link = &callbacks[CALLBACK_BUCKET(pcb)]; *link != NULL; link = &(*link)->next) {
+        if ((*link)->code == (void*)pcb) {
+            cb    = *link;
+            *link = cb->next;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&callbacksLock);
+
+    if (cb != NULL) {
+        freeCallback(cb);
+    }
+}
+
+void* dcbGetUserData(DCCallback* pcb) {
+    DCFFICallback* cb;
+    void*          userdata = NULL;
+
+    pthread_mutex_lock(&callbacksLock);
+    for (cb = callbacks[CALLBACK_BUCKET(pcb)]; cb != NULL; cb = cb->next) {
+        if (cb->code == (void*)pcb) {
+            userdata = cb->userdata;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&callbacksLock);
+
+    return userdata;
+}
+
+/* Reads the next argument, converted according to the type it was declared with in the callback signature. */
+static int nextArg(DCArgs* args, long long* i, double* d) {
+    ffi_type* type;
+    void*     v;
+
+    *i = 0;
+    *d = 0;
+    if (args->index >= args->cif->nargs) {
+        return 0;
+    }
+
+    type = args->cif->arg_types[args->index];
+    v    = args->values[args->index];
+    args->index++;
+
+    switch (type->type) {
+        case FFI_TYPE_SINT8:   *i = *(int8_t*)v;                 break;
+        case FFI_TYPE_UINT8:   *i = *(uint8_t*)v;                break;
+        case FFI_TYPE_SINT16:  *i = *(int16_t*)v;                break;
+        case FFI_TYPE_UINT16:  *i = *(uint16_t*)v;               break;
+        case FFI_TYPE_SINT32:  *i = *(int32_t*)v;                break;
+        case FFI_TYPE_UINT32:  *i = *(uint32_t*)v;               break;
+        case FFI_TYPE_SINT64:  *i = *(int64_t*)v;                break;
+        case FFI_TYPE_UINT64:  *i = (long long)*(uint64_t*)v;    break;
+        case FFI_TYPE_POINTER: *i = (long long)(intptr_t)*(void**)v; break;
+        case FFI_TYPE_FLOAT:   *d = *(float*)v;                  return 1;
+        case FFI_TYPE_DOUBLE:  *d = *(double*)v;                 return 1;
+        default: break;
+    }
+    return 1;
+}
+
+#define DEFINE_ARG_INT(Name, Type) \
+    Type dcbArg##Name(DCArgs* args) { \
+        long long i; \
+        double    d; \
+        nextArg(args, &i, &d); \
+        return (Type)i; \
+    }
+
+DCbool dcbArgBool(DCArgs* args) {
+    long long i;
+    double    d;
+    nextArg(args, &i, &d);
+    return i != 0;
+}
+
+DEFINE_ARG_INT(Char,      DCchar)
+DEFINE_ARG_INT(Short,     DCshort)
+DEFINE_ARG_INT(Int,       DCint)
+DEFINE_ARG_INT(Long,      DClong)
+DEFINE_ARG_INT(LongLong,  DClonglong)
+DEFINE_ARG_INT(UChar,     DCuchar)
+DEFINE_ARG_INT(UShort,    DCushort)
+DEFINE_ARG_INT(UInt,      DCuint)
+DEFINE_ARG_INT(ULong,     DCulong)
+DEFINE_ARG_INT(ULongLong, DCulonglong)
+
+DCpointer dcbArgPointer(DCArgs* args) {
+    long long i;
+    double    d;
+    nextArg(args, &i, &d);
+    return (DCpointer)(intptr_t)i;
+}
+
+DCfloat dcbArgFloat(DCArgs* args) {
+    long long i;
+    double    d;
+    nextArg(args, &i, &d);
+    return (DCfloat)d;
+}
+
+DCdouble dcbArgDouble(DCArgs* args) {
+    long long i;
+    double    d;
+    nextArg(args, &i, &d);
+    return d;
+}
+
+/* ------------------------------------------------------------------------------------------------------------------ */
+/* dynload                                                                                                            */
+/* ------------------------------------------------------------------------------------------------------------------ */
+
+DLLib* dlLoadLibrary(const char* libpath) {
+    return (DLLib*)dlopen(libpath, RTLD_LAZY | RTLD_LOCAL);
+}
+
+void dlFreeLibrary(DLLib* pLib) {
+    if (pLib != NULL) {
+        dlclose((void*)pLib);
+    }
+}
+
+void* dlFindSymbol(DLLib* pLib, const char* pSymbolName) {
+    return dlsym(pLib == NULL ? RTLD_DEFAULT : (void*)pLib, pSymbolName);
+}
+
+int dlGetLibraryPath(DLLib* pLib, char* sOut, int bufSize) {
+#ifdef __sun
+    Link_map* map = NULL;
+    size_t    length;
+
+    if (pLib == NULL || dlinfo((void*)pLib, RTLD_DI_LINKMAP, &map) != 0 || map == NULL || map->l_name == NULL) {
+        return 0;
+    }
+
+    length = strlen(map->l_name) + 1;
+    if (sOut != NULL && length <= (size_t)bufSize) {
+        memcpy(sOut, map->l_name, length);
+    }
+    return (int)length;
+#else
+    (void)pLib;
+    (void)sOut;
+    (void)bufSize;
+    return 0;
+#endif
+}
+
+DLSyms* dlSymsInit(const char* libPath) {
+    (void)libPath;
+    return NULL;
+}
+
+void dlSymsCleanup(DLSyms* pSyms) {
+    (void)pSyms;
+}
+
+int dlSymsCount(DLSyms* pSyms) {
+    (void)pSyms;
+    return 0;
+}
+
+const char* dlSymsName(DLSyms* pSyms, int index) {
+    (void)pSyms;
+    (void)index;
+    return NULL;
+}
+
+const char* dlSymsNameFromValue(DLSyms* pSyms, void* value) {
+    (void)pSyms;
+    (void)value;
+    return NULL;
+}
