# Minecraft 1.19
MC_VERSION=1.19
LWJGL_VERSION=3.3.1
LWJGL_URL=${LWJGL_URL:-https://github.com/LWJGL/lwjgl3.git}
LWJGL_REF=${LWJGL_REF:-3.3.1}
# GLFW, jemalloc and OpenAL Soft keep a stable C ABI, so one pinned ref serves
# every version. Override here if a release ever needs an exact match.
GLFW_URL=${GLFW_URL:-https://github.com/glfw/glfw.git}
GLFW_REF=${GLFW_REF:-3.5.1}
JEMALLOC_URL=${JEMALLOC_URL:-https://github.com/jemalloc/jemalloc.git}
JEMALLOC_REF=${JEMALLOC_REF:-5.3.0}
OPENAL_URL=${OPENAL_URL:-https://github.com/kcat/openal-soft.git}
OPENAL_REF=${OPENAL_REF:-1.23.1}
# Static libffi for liblwjgl.so; the SunOS ant config requires LWJGL_SUNOS_LIBFFI_A.
LIBFFI_URL=${LIBFFI_URL:-https://github.com/libffi/libffi.git}
LIBFFI_REF=${LIBFFI_REF:-v3.8.0}
COMPONENTS="libffi glfw lwjgl3 jemalloc openal"
NATIVES="liblwjgl.so libjemalloc.so libopenal.so liblwjgl_opengl.so liblwjgl_stb.so libglfw.so liblwjgl_tinyfd.so"
